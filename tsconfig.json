{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "config/**/*.ts", ".expo/types/**/*.d.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "supabase/functions", "evals"]
}

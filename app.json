{
  "expo": {
    "name": "무늬",
    "slug": "ilgi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/png/app-icon-1024.png",
    "userInterfaceStyle": "automatic",
    "scheme": "munui",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.munui.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.munui.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/png/android-adaptive-foreground-1024.png",
        "backgroundColor": "#FBF1E4",
        "monochromeImage": "./assets/brand/png/android-monochrome-1024.png"
      }
    },
    "web": {
      "favicon": "./assets/brand/png/favicon-48.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/png/mark-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF1E4"
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "무늬 앱 잠금을 해제할 때 Face ID를 사용해요."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D97B3C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "19429e1e-8282-4416-9be1-4bd4620211f1"
      }
    }
  }
}

# MODEL_PLUS=claude-sonnet-4-6
# MODEL_FREE=claude-haiku-4-5-20251001
# MODEL_UTILITY=claude-haiku-4-5-20251001
# REVENUECAT_WEBHOOK_SECRET=your-secret

# Server-only: used by `npm run eval` (never prefix with EXPO_PUBLIC_)
ANTHROPIC_API_KEY=
